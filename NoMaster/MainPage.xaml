<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="NoMaster.MainPage"
             BackgroundColor="#121212">

    <ScrollView>
        <VerticalStackLayout Spacing="40"
                             Padding="30"
                             VerticalOptions="Center"
                             HorizontalOptions="Center">

            <!-- Title -->
            <Label Text="NoMaster"
                   FontSize="48"
                   FontAttributes="Bold"
                   TextColor="#FF6B6B"
                   HorizontalOptions="Center" />

            <Label Text="Powered by No-as-a-Service 😏"
                   FontSize="20"
                   TextColor="#B0B0B0"
                   HorizontalOptions="Center" />

            <!-- Quote-style reason display -->
            <Border BackgroundColor="#1E1E1E"
                    Stroke="#333333"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 20"
                    Padding="30"
                    MinimumHeightRequest="200">

                <!-- Shadow on the Border itself -->
                <Border.Shadow>
                    <Shadow Brush="Black"
                            Offset="5,10"
                            Radius="20"
                            Opacity="0.8" />
                </Border.Shadow>

                <!-- The single child content: the Label with the reason -->
                <Label x:Name="ReasonLabel"
                       Text="Tap below to get a creative 'No'!"
                       FontSize="28"
                       TextColor="White"
                       FontAttributes="Italic"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </Border>

            <!-- Loading spinner -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               Color="#FF6B6B"
                               IsRunning="False"
                               HeightRequest="50" />

            <!-- Big fun button -->
            <Button Text="Get a No!"
                    FontSize="28"
                    FontAttributes="Bold"
                    BackgroundColor="#FF6B6B"
                    TextColor="White"
                    CornerRadius="30"
                    HeightRequest="80"
                    WidthRequest="300"
                    Clicked="OnGetNoClicked">

                <!-- Shadow on the Button -->
                <Button.Shadow>
                    <Shadow Brush="#80000000"
                            Offset="5,10"
                            Radius="20"
                            Opacity="0.8" />
                </Button.Shadow>
            </Button>

            <!-- Footer -->
            <Label Text="Built with .NET MAUI ❤️"
                   FontSize="16"
                   TextColor="#666666"
                   HorizontalOptions="Center"
                   Margin="0,40,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>